void transmit_uart(char *string) {
    HAL_UART_Transmit(&huart2, (uint8_t*) string, strlen(string), HAL_MAX_DELAY);
}

char receive_uart_char(void) {
    uint8_t ch;
    HAL_UART_Receive(&huart2, &ch, 1, HAL_MAX_DELAY);
    return (char)ch;
}

void list_files(void) {
    DIR dir;
    FILINFO fno;

    if (f_opendir(&dir, "0:/") == FR_OK) {
        transmit_uart("Archivos en SD:\r\n");
        while (1) {
            if (f_readdir(&dir, &fno) != FR_OK || fno.fname[0] == 0) break;
            if (fno.fattrib & AM_DIR) {
                sprintf(buffer, "  <DIR> %s\r\n", fno.fname);
            } else {
                sprintf(buffer, "  %s  (%lu bytes)\r\n", fno.fname, fno.fsize);
            }
            transmit_uart(buffer);
        }
        f_closedir(&dir);
    } else {
        transmit_uart("Error abriendo directorio\r\n");
    }
}

int list_txt_files(void) {
    DIR dir;
    FILINFO fno;
    int count = 0;

    if (f_opendir(&dir, "0:/") == FR_OK) {
        transmit_uart("Archivos TXT disponibles:\r\n");
        while (1) {
            if (f_readdir(&dir, &fno) != FR_OK || fno.fname[0] == 0) break;
            if (!(fno.fattrib & AM_DIR)) {
                if (strstr(fno.fname, ".txt") != NULL) {
                    if (count < MAXIMO) {
                        strcpy(file_list[count], fno.fname);
                        sprintf(buffer, "%d) %s\r\n", count + 1, fno.fname);
                        transmit_uart(buffer);
                        count++;
                    }
                }
            }
        }
        f_closedir(&dir);
    } else {
        transmit_uart("Error al abrir directorio\r\n");
    }
    return count;
}

void read_file(char *filename) {
    FIL fil;
    FRESULT fres;

    fres = f_open(&fil, filename, FA_READ);
    if (fres == FR_OK) {
        transmit_uart("Contenido del archivo:\r\n");
        while (f_gets(buffer, sizeof(buffer), &fil)) {
            transmit_uart(buffer);
        }
        f_close(&fil);
    } else {
        transmit_uart("Error al abrir archivo \r\n");
    }
}

void menu_read_file(void) {
    int count = list_txt_files();
    if (count == 0) {
        transmit_uart("No hay archivos .txt\r\n");
        return;
    }

    transmit_uart("Selecciona numero del archivo: ");
    char opt = receive_uart_char();
    sprintf(buffer, "%c\r\n", opt);
    transmit_uart(buffer);

    int idx = opt - '0';
    if (idx > 0 && idx <= count) {
        read_file(file_list[idx - 1]);
    } else {
        transmit_uart("Numero invalido\r\n");
    }
}

